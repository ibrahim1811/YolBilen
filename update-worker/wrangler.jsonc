{
  "name": "yolbul-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "UPDATES", "bucket_name": "yolbul-updates" }
  ],
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "yolbul-reports",
      "database_id": "9690347b-f0bb-46fa-a195-7692ad4def86"
    }
  ],
  // OTA_TOKEN gizli değişkeni: yükleme ve rapor okuma yetkisi (wrangler secret put OTA_TOKEN)
  "observability": { "enabled": true }
}
